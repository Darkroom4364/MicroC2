{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microc2.local/schemas/module-catalog-v1.schema.json",
  "title": "MicroC2 Module Catalog v1",
  "description": "Closed, compile-time registered agent modules visible to authenticated operators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "modules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description",
        "input_schema",
        "output_schema",
        "safety"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "input_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "output_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk_level",
            "target_scope",
            "requires_operator_acknowledgement",
            "evidence_required"
          ],
          "properties": {
            "risk_level": {
              "enum": [
                "read_only",
                "controlled",
                "high_impact"
              ]
            },
            "target_scope": {
              "enum": [
                "self",
                "explicit_target"
              ]
            },
            "requires_operator_acknowledgement": {
              "type": "boolean"
            },
            "evidence_required": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
