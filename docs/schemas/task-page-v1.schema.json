{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microc2.local/schemas/task-page-v1.schema.json",
  "title": "MicroC2 Task Page v1",
  "description": "Bounded, newest-first page of operator task summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tasks",
    "limit",
    "offset",
    "total",
    "next_offset"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "task-summary-v1.schema.json"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
